{
  "openapi": "3.1.0",
  "info": {
    "title": "Cairn dashboard",
    "description": "The API of Cairn's dashboard.",
    "contact": {
      "name": "Justus Zorn"
    },
    "license": {
      "name": "AGPL-3.0-or-later",
      "identifier": "AGPL-3.0-or-later"
    },
    "version": "0.3.0"
  },
  "servers": [
    {
      "url": "/_dashboard/api"
    }
  ],
  "paths": {
    "/buckets": {
      "get": {
        "operationId": "list_buckets",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BucketSummary"
                  }
                }
              }
            }
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "create_bucket",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewBucket"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/buckets/{bucket}": {
      "delete": {
        "summary": "Deletes an empty bucket.",
        "operationId": "delete_bucket",
        "parameters": [
          {
            "name": "bucket",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/buckets/{bucket}/download": {
      "get": {
        "summary": "An object's data, as a file to save. It's always sent as an attachment of\nno particular type, so that a browser never renders it as part of the UI.",
        "operationId": "download",
        "parameters": [
          {
            "name": "bucket",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "query",
            "description": "The version to download; the current one if not given.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The object's data",
            "content": {
              "application/octet-stream": {}
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/buckets/{bucket}/object": {
      "get": {
        "operationId": "get_object",
        "parameters": [
          {
            "name": "bucket",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectInfo"
                }
              }
            }
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/buckets/{bucket}/objects": {
      "get": {
        "operationId": "list_objects",
        "parameters": [
          {
            "name": "bucket",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "prefix",
            "in": "query",
            "description": "List what's under this prefix.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Resume after this key (a page's `next`).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "deleted",
            "in": "query",
            "description": "Also list keys whose current version is a delete marker.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Listing"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/cluster": {
      "get": {
        "summary": "The nodes, each with the metrics it reports, if it's live.",
        "operationId": "get_cluster",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cluster"
                }
              }
            }
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/roles": {
      "get": {
        "operationId": "list_roles",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RoleSummary"
                  }
                }
              }
            }
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "create_role",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewRole"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Secret"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/roles/{role}": {
      "delete": {
        "operationId": "delete_role",
        "parameters": [
          {
            "name": "role",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted, with its grants"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/roles/{role}/admin": {
      "put": {
        "summary": "Makes a role an admin, or not.",
        "operationId": "set_admin",
        "parameters": [
          {
            "name": "role",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminFlag"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Changed"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/roles/{role}/grants": {
      "post": {
        "summary": "Grants permissions on an existing bucket.",
        "operationId": "grant",
        "parameters": [
          {
            "name": "role",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewGrant"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Granted"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "revoke",
        "parameters": [
          {
            "name": "role",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bucket",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "permission",
            "in": "query",
            "description": "The permission to revoke; all of them on the bucket if not given.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Permission"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/roles/{role}/secret": {
      "post": {
        "summary": "Replaces a role's secret.",
        "operationId": "rotate_secret",
        "parameters": [
          {
            "name": "role",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewSecret"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Secret"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/storage": {
      "get": {
        "operationId": "get_storage",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Storage"
                }
              }
            }
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminFlag": {
        "type": "object",
        "required": [
          "admin"
        ],
        "properties": {
          "admin": {
            "type": "boolean"
          }
        }
      },
      "Backlog": {
        "type": "object",
        "required": [
          "packing",
          "packing_bytes",
          "consolidate",
          "consolidate_bytes",
          "compact",
          "compact_garbage_bytes",
          "garbage_log",
          "uploads",
          "upload_bytes"
        ],
        "properties": {
          "compact": {
            "type": "integer",
            "format": "int64",
            "description": "Blobs with enough garbage to be compacted."
          },
          "compact_garbage_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "consolidate": {
            "type": "integer",
            "format": "int64",
            "description": "Blobs small enough to be consolidated."
          },
          "consolidate_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "garbage_log": {
            "type": "integer",
            "format": "int64",
            "description": "Deleted parts the packer hasn't folded yet."
          },
          "oldest_upload": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "packing": {
            "type": "integer",
            "format": "int64",
            "description": "Blobs leased by packing jobs, right now."
          },
          "packing_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "upload_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "uploads": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "BlobTotals": {
        "type": "object",
        "required": [
          "committed",
          "bytes",
          "garbage_bytes",
          "pending"
        ],
        "properties": {
          "bytes": {
            "type": "integer",
            "format": "int64"
          },
          "committed": {
            "type": "integer",
            "format": "int64"
          },
          "garbage_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes of packed blobs that no part references anymore."
          },
          "oldest_pending": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "pending": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "BucketSummary": {
        "type": "object",
        "required": [
          "name",
          "created_at",
          "versioning",
          "objects",
          "bytes",
          "versions",
          "version_bytes",
          "uploads",
          "roles"
        ],
        "properties": {
          "bytes": {
            "type": "integer",
            "format": "int64"
          },
          "created_at": {
            "type": "number",
            "format": "double"
          },
          "name": {
            "type": "string"
          },
          "objects": {
            "type": "integer",
            "format": "int64",
            "description": "Current versions that aren't delete markers."
          },
          "roles": {
            "type": "integer",
            "format": "int64",
            "description": "Roles with a grant on the bucket."
          },
          "uploads": {
            "type": "integer",
            "format": "int64"
          },
          "version_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "versioning": {
            "$ref": "#/components/schemas/Versioning"
          },
          "versions": {
            "type": "integer",
            "format": "int64",
            "description": "Every version, delete markers too."
          }
        }
      },
      "Cluster": {
        "type": "object",
        "required": [
          "this_node",
          "replication_factor",
          "now",
          "nodes"
        ],
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClusterNode"
            }
          },
          "now": {
            "type": "number",
            "format": "double"
          },
          "replication_factor": {
            "type": "integer",
            "minimum": 0
          },
          "this_node": {
            "type": "integer",
            "format": "int32",
            "description": "The node answering."
          }
        }
      },
      "ClusterNode": {
        "type": "object",
        "required": [
          "id",
          "node_id",
          "peer_url",
          "last_seen",
          "free_space",
          "live"
        ],
        "properties": {
          "free_space": {
            "type": "integer",
            "format": "int64",
            "description": "As of its last heartbeat."
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "last_seen": {
            "type": "number",
            "format": "double"
          },
          "live": {
            "type": "boolean",
            "description": "Seen within the last 10 seconds."
          },
          "node_id": {
            "type": "string"
          },
          "peer_url": {
            "type": "string"
          },
          "stats": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/NodeStats",
                "description": "What the node reported, if it's live and answered."
              },
              {
                "type": "null"
              }
            ]
          },
          "stats_error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why a live node's stats are missing."
          }
        }
      },
      "Counts": {
        "type": "object",
        "description": "Counts of requests, by how they ended, and of what they moved.",
        "required": [
          "requests",
          "client_errors",
          "server_errors",
          "bytes_in",
          "bytes_out",
          "latency_us"
        ],
        "properties": {
          "bytes_in": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "bytes_out": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "client_errors": {
            "type": "integer",
            "format": "int64",
            "description": "Answered with a 4xx: the client's fault (including denied requests).",
            "minimum": 0
          },
          "latency_us": {
            "type": "integer",
            "format": "int64",
            "description": "The sum of the times until the response's head was ready.",
            "minimum": 0
          },
          "requests": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "server_errors": {
            "type": "integer",
            "format": "int64",
            "description": "Answered with a 5xx: a fault, or too few nodes.",
            "minimum": 0
          }
        }
      },
      "Disk": {
        "type": "object",
        "required": [
          "total",
          "available"
        ],
        "properties": {
          "available": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes Cairn may still write.",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes in all.",
            "minimum": 0
          }
        }
      },
      "Entry": {
        "oneOf": [
          {
            "type": "object",
            "description": "A \"directory\": the keys whose names continue past the prefix with `/`.",
            "required": [
              "prefix",
              "objects",
              "bytes",
              "last_modified",
              "kind"
            ],
            "properties": {
              "bytes": {
                "type": "integer",
                "format": "int64"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "prefix"
                ]
              },
              "last_modified": {
                "type": "number",
                "format": "double"
              },
              "objects": {
                "type": "integer",
                "format": "int64"
              },
              "prefix": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "description": "A key's current version.",
            "required": [
              "key",
              "size",
              "last_modified",
              "delete_marker",
              "kind"
            ],
            "properties": {
              "delete_marker": {
                "type": "boolean"
              },
              "etag": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "key": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "object"
                ]
              },
              "last_modified": {
                "type": "number",
                "format": "double"
              },
              "size": {
                "type": "integer",
                "format": "int64"
              }
            }
          }
        ]
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "What went wrong, for a person to read."
          }
        }
      },
      "EventReport": {
        "type": "object",
        "required": [
          "time",
          "source",
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "`gc`, `packer` or `maintenance`."
          },
          "time": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "GcTotals": {
        "type": "object",
        "description": "What garbage collection deleted since the node started.",
        "required": [
          "pending",
          "files",
          "dirs",
          "errors"
        ],
        "properties": {
          "dirs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "errors": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "files": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "pending": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "Grant": {
        "type": "object",
        "required": [
          "bucket",
          "permission"
        ],
        "properties": {
          "bucket": {
            "type": "string"
          },
          "permission": {
            "$ref": "#/components/schemas/Permission"
          }
        }
      },
      "Listing": {
        "type": "object",
        "description": "A page of a bucket's keys, rolled up at `/` like a directory listing.",
        "required": [
          "entries"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          },
          "next": {
            "type": [
              "string",
              "null"
            ],
            "description": "What to pass as `after` for the next page, if there is one."
          }
        }
      },
      "MaintenanceReport": {
        "type": "object",
        "required": [
          "interval_secs",
          "passes",
          "sweep_shard",
          "shards",
          "gc",
          "packer",
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventReport"
            },
            "description": "The most recent things a pass did or failed at, oldest first."
          },
          "gc": {
            "$ref": "#/components/schemas/GcTotals"
          },
          "interval_secs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "last_duration": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "How many seconds the last pass took."
          },
          "last_started": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "packer": {
            "$ref": "#/components/schemas/PackerTotals"
          },
          "passes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "running_since": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "When the pass that's running started."
          },
          "shards": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "sweep_shard": {
            "type": "integer",
            "format": "int32",
            "description": "Where the GC's file sweep is, of `shards`.",
            "minimum": 0
          }
        }
      },
      "MetricsReport": {
        "type": "object",
        "description": "A node's metrics. Times are seconds since the Unix epoch.",
        "required": [
          "started_at",
          "in_flight",
          "requests",
          "maintenance"
        ],
        "properties": {
          "in_flight": {
            "type": "integer",
            "format": "int64",
            "description": "Requests whose response hasn't been sent in full yet."
          },
          "maintenance": {
            "$ref": "#/components/schemas/MaintenanceReport"
          },
          "requests": {
            "$ref": "#/components/schemas/RequestsReport"
          },
          "started_at": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "NewBucket": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "NewGrant": {
        "type": "object",
        "required": [
          "bucket",
          "permissions"
        ],
        "properties": {
          "bucket": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          }
        }
      },
      "NewRole": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "admin": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "secret": {
            "type": [
              "string",
              "null"
            ],
            "description": "At least 8 characters; one is generated if not given."
          }
        }
      },
      "NewSecret": {
        "type": "object",
        "properties": {
          "secret": {
            "type": [
              "string",
              "null"
            ],
            "description": "At least 8 characters; one is generated if not given."
          }
        }
      },
      "NodeHolding": {
        "type": "object",
        "description": "The committed blobs a node holds a copy of.",
        "required": [
          "node",
          "blobs",
          "bytes"
        ],
        "properties": {
          "blobs": {
            "type": "integer",
            "format": "int64"
          },
          "bytes": {
            "type": "integer",
            "format": "int64"
          },
          "node": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "NodeStats": {
        "allOf": [
          {
            "$ref": "#/components/schemas/MetricsReport"
          },
          {
            "type": "object",
            "required": [
              "node",
              "node_id",
              "version",
              "replication_factor",
              "now"
            ],
            "properties": {
              "disk": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Disk",
                    "description": "The filesystem of its data dir, if it could tell."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "disk_error": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "node": {
                "type": "integer",
                "format": "int32"
              },
              "node_id": {
                "type": "string"
              },
              "now": {
                "type": "number",
                "format": "double",
                "description": "The node's clock, in seconds since the Unix epoch."
              },
              "replication_factor": {
                "type": "integer",
                "minimum": 0
              },
              "version": {
                "type": "string"
              }
            }
          }
        ],
        "description": "What a node reports about itself, for the dashboard of any node (see\n`peer`'s `/stats`)."
      },
      "ObjectInfo": {
        "type": "object",
        "description": "Every version of a key (the newest 200), each with its parts and where their\nblobs are stored.",
        "required": [
          "bucket",
          "key",
          "versions"
        ],
        "properties": {
          "bucket": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VersionInfo"
            },
            "description": "Newest first; empty if there's no such key."
          }
        }
      },
      "ObjectTotals": {
        "type": "object",
        "required": [
          "buckets",
          "current",
          "current_bytes",
          "noncurrent",
          "noncurrent_bytes",
          "delete_markers"
        ],
        "properties": {
          "buckets": {
            "type": "integer",
            "format": "int64"
          },
          "current": {
            "type": "integer",
            "format": "int64"
          },
          "current_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "delete_markers": {
            "type": "integer",
            "format": "int64"
          },
          "noncurrent": {
            "type": "integer",
            "format": "int64"
          },
          "noncurrent_bytes": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "OpCounts": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Counts"
          },
          {
            "type": "object",
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "type": "string"
              }
            }
          }
        ]
      },
      "PackerSettings": {
        "type": "object",
        "required": [
          "target_size",
          "small_size",
          "compact_threshold",
          "max_sources"
        ],
        "properties": {
          "compact_threshold": {
            "type": "number",
            "format": "double"
          },
          "max_sources": {
            "type": "integer",
            "format": "int64"
          },
          "small_size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "target_size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "PackerTotals": {
        "type": "object",
        "description": "What the packer did since the node started.",
        "required": [
          "jobs",
          "failed",
          "blobs",
          "parts",
          "bytes"
        ],
        "properties": {
          "blobs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "jobs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "parts": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "PartInfo": {
        "type": "object",
        "required": [
          "number",
          "size",
          "etag",
          "blob_id",
          "blob_offset",
          "blob_size",
          "blob_state",
          "created_at",
          "nodes"
        ],
        "properties": {
          "blob_id": {
            "type": "string"
          },
          "blob_offset": {
            "type": "integer",
            "format": "int64",
            "description": "Where in the blob the part's bytes start."
          },
          "blob_size": {
            "type": "integer",
            "format": "int64"
          },
          "blob_state": {
            "type": "string"
          },
          "crc64nvme": {
            "type": [
              "string",
              "null"
            ],
            "description": "The CRC64/NVME of the part's bytes, in hex; none for old data."
          },
          "created_at": {
            "type": "number",
            "format": "double"
          },
          "etag": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The nodes holding a copy of the blob."
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Permission": {
        "type": "string",
        "description": "A bucket-level permission a role can be granted.",
        "enum": [
          "read",
          "write",
          "delete-version"
        ]
      },
      "ReplicaGroup": {
        "type": "object",
        "description": "The committed blobs with `copies` copies, `live` of them on live nodes.",
        "required": [
          "live",
          "copies",
          "blobs",
          "bytes"
        ],
        "properties": {
          "blobs": {
            "type": "integer",
            "format": "int64"
          },
          "bytes": {
            "type": "integer",
            "format": "int64"
          },
          "copies": {
            "type": "integer",
            "format": "int64"
          },
          "live": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "RequestsReport": {
        "type": "object",
        "required": [
          "slot_secs",
          "ops",
          "history"
        ],
        "properties": {
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlotCounts"
            },
            "description": "The last hour's slots that had requests, oldest first."
          },
          "ops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpCounts"
            },
            "description": "Since the node started, by operation."
          },
          "slot_secs": {
            "type": "integer",
            "format": "int64",
            "description": "How many seconds a slot of `history` covers.",
            "minimum": 0
          }
        }
      },
      "RoleSummary": {
        "type": "object",
        "description": "A role, never with its secret.",
        "required": [
          "name",
          "admin",
          "created_at",
          "grants"
        ],
        "properties": {
          "admin": {
            "type": "boolean"
          },
          "created_at": {
            "type": "number",
            "format": "double"
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Grant"
            }
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Secret": {
        "type": "object",
        "description": "A role's secret, which is shown only this once.",
        "required": [
          "name",
          "secret"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "secret": {
            "type": "string"
          }
        }
      },
      "SlotCounts": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Counts"
          },
          {
            "type": "object",
            "required": [
              "t"
            ],
            "properties": {
              "t": {
                "type": "integer",
                "format": "int64",
                "description": "When the slot starts. The same on every node, so slots add up.",
                "minimum": 0
              }
            }
          }
        ]
      },
      "Storage": {
        "type": "object",
        "description": "What's stored where, how well it's replicated, and what the background jobs\nstill have to do.",
        "required": [
          "replication_factor",
          "nodes",
          "replicas",
          "blobs",
          "objects",
          "backlog",
          "packer"
        ],
        "properties": {
          "backlog": {
            "$ref": "#/components/schemas/Backlog"
          },
          "blobs": {
            "$ref": "#/components/schemas/BlobTotals"
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NodeHolding"
            }
          },
          "objects": {
            "$ref": "#/components/schemas/ObjectTotals"
          },
          "packer": {
            "$ref": "#/components/schemas/PackerSettings"
          },
          "replicas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReplicaGroup"
            }
          },
          "replication_factor": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "VersionInfo": {
        "type": "object",
        "required": [
          "version_id",
          "latest",
          "delete_marker",
          "size",
          "last_modified",
          "parts"
        ],
        "properties": {
          "content_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "delete_marker": {
            "type": "boolean"
          },
          "etag": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_modified": {
            "type": "number",
            "format": "double"
          },
          "latest": {
            "type": "boolean"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartInfo"
            }
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "version_id": {
            "type": "string"
          }
        }
      },
      "Versioning": {
        "type": "string",
        "description": "A bucket's versioning state. A bucket starts out unversioned; once enabled,\nit only moves between enabled and suspended. Serialized as it's stored.",
        "enum": [
          "unversioned",
          "enabled",
          "suspended"
        ]
      }
    }
  }
}
