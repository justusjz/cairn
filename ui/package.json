{
  "name": "cairn-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "gen": "openapi-typescript openapi.json --output src/schema.d.ts",
    "dev": "npm run gen && vite",
    "build": "npm run gen && tsc --noEmit && vite build",
    "check": "npm run gen && tsc --noEmit"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "openapi-fetch": "^0.17.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  }
}
