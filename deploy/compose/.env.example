# Copy to .env, and fill in. Each of the domains needs DNS records pointing
# at this host (see README.md, "Docker Compose").

# The S3 API: s3.example.com, and buckets virtual-hosted at
# <bucket>.s3.example.com.
S3_DOMAIN=s3.example.com
# The console.
CONSOLE_DOMAIN=console.example.com
# Buckets' websites, at <bucket>.s3-website.example.com. Custom domains need
# nothing here: a bucket named after one serves its website there.
WEBSITE_DOMAIN=s3-website.example.com

# Postgres's password: letters and digits only, as it goes into a URL
# (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=

# The Cairn image's tag (a release, e.g. 0.8.1), or latest.
CAIRN_VERSION=latest

# Wildcard certificates for buckets and websites (compose.wildcard.yaml):
# uncomment both, and set the token.
#COMPOSE_FILE=compose.yaml:compose.wildcard.yaml
#CLOUDFLARE_API_TOKEN=
